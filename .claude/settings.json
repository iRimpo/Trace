{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-verifier.sh\"",
            "timeout": 10,
            "statusMessage": "Checking verifier boundary"
          }
        ]
      }
    ]
  }
}
