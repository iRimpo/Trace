{
  "name": "trace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "_comment_build:check": "Verification build that writes to .next-check, so it cannot clobber a running dev server's chunks. Use this while `npm run dev` is up; plain `build` is for CI/Vercel.",
    "build:check": "NEXT_DIST_DIR=.next-check next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "deploy": "vercel --prod",
    "loop:verify": "loop/verify.sh",
    "loop:full": "FULL=1 loop/verify.sh",
    "test:props": "vitest run --config loop/vitest.loop.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/three": "^0.183.1",
    "framer-motion": "^12.34.0",
    "next": "14.2.35",
    "posthog-js": "^1.356.1",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^10.0.2",
    "react-type-animation": "^3.2.0",
    "recharts": "^3.7.0",
    "three": "^0.183.1",
    "web-audio-beat-detector": "^8.2.35"
  },
  "devDependencies": {
